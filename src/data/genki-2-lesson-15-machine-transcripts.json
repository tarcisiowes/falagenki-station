        "end": 18.76,
        "start": 14.62,
        "text": "うーん 別に どうして?"
      },
      {
        "end": 25.08,
        "start": 18.76,
        "text": "ゆいさんの長野のうちに行こうと思ってるんだけど 一緒に行かない?"
      },
      {
        "end": 26.52,
        "start": 25.08,
        "text": "いいの?"
      },
      {
        "end": 33.48,
        "start": 26.68,
        "text": "うん ゆいさんがタケシ君も誘ってと言ってたから"
      },
      {
        "end": 39.28,
        "start": 33.48,
        "text": "じゃあ行く 電車の時間調べておくよ"
      },
      {
        "end": 46.04,
        "start": 39.28,
        "text": "ありがとう じゃあ私 ゆいさんに電話しておく"
      }
    ]
  },
