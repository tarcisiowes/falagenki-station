        "text": "田中さんにもらったコーヒーを飲んでみました。"
      },
      {
        "end": 20.87,
        "start": 10.39,
        "text": "1.妹が作った料理はおいしくないです。"
      },
      {
        "end": 31.45,
        "start": 20.87,
        "text": "2.料理ができない人と結婚したくないです。"
      },
      {
        "end": 41.46,
        "start": 31.45,
        "text": "3.日本の週刊についてよく知っている外国人を探しています。"
      },
      {
        "end": 51.97,
        "start": 41.46,
        "text": "4.去年の夏に会った人にもう一度会いたいです。"
      },
      {
        "end": 62.35,
        "start": 51.97,
        "text": "5.よく喋る人とルームメートになりたくないです。"
      },
      {
        "end": 73.7,
        "start": 62.35,
        "text": "6.おじさんが働いている会社はこの建物の中にあります。"
      },
      {
        "end": 85.18,
        "start": 73.7,
        "text": "7.冬休みに温泉がある旅館に止まろうと思っています。"
      },
      {
        "end": 98.63,
        "start": 85.18,
        "text": "8.留学に興味があるんですが、アメリカに留学したことがある学生を知っていますか?"
      }
    ]
  },
  "W15_A": {
    "duration": 59.85,
    "language": "ja",
    "languageProbability": 0.9864,
    "segments": [
      {
        "end": 6.33,
        "start": 0.18,
        "text": "第15日 きくれんしゅう"
      },
      {
        "end": 8.83,
        "start": 6.33,
        "text": "えい"
      },
      {
        "end": 13.23,
        "start": 8.83,
        "text": "これはおじいさんが若い時 使っていたラジオ"
      },
      {
        "end": 19.21,
        "start": 13.23,
        "text": "古いけど使えるよ 妹があんだマフラ"
      },
      {
        "end": 25.43,
        "start": 19.21,
        "text": "僕の妹はいろいろ作るのが好きだから よくくれるんだ"
      },
      {
        "end": 30.07,
        "start": 25.43,
        "text": "これは僕の彼女と京都で撮った写真"
      },
      {
        "end": 37.75,
        "start": 30.07,
        "text": "その時にお寺で買った着物があそこにある すごく安かったんだ"
      },
      {
        "end": 45.77,
        "start": 37.75,
        "text": "これは両親がくれたぬいぐるみ 子供の時よく遊んだ"
      },
      {
        "end": 51.69,
        "start": 45.77,
        "text": "えっと これは先生に借りた歴史の本"
      },
      {
        "end": 55.21,
        "start": 51.69,
        "text": "明日返さなきゃいけない"
      }
    ]
  },
  "W15_B": {
    "duration": 66.9,
    "language": "ja",
    "languageProbability": 0.9832,
    "segments": [
      {
        "end": 2.08,
        "start": 0.08,
        "text": "B"
      },
      {
        "end": 8.08,
        "start": 2.08,
        "text": "ねえ、そらさん、今度の休みに何をするの?"
      },
      {
        "end": 10.08,
        "start": 8.08,
        "text": "まだわからない"
      },
      {
        "end": 18.08,
        "start": 10.08,
        "text": "もうすぐ試験があるし、宿題もしなきゃいけないし、うちで勉強しようと思っているんだ"
      },
      {
        "end": 24.08,
        "start": 18.08,
        "text": "ええ、だめだよ、1週間も休みがあるんだよ"
      },
      {
        "end": 26.08,
        "start": 24.08,
        "text": "うーん"
      },
      {
        "end": 28.08,
        "start": 26.08,
        "text": "広島に行ったことがある?"
      },
      {
        "end": 32.08,
        "start": 28.08,
        "text": "うーん、まだ行ったことがない"
      },
      {
        "end": 36.08,
        "start": 32.08,
        "text": "今度の休みに広島に行こうよ"
      },
      {
        "end": 42.08,
        "start": 36.08,
        "text": "広島は食べ物もおいしいし、平和公園にも行きたいし"
      },
      {
        "end": 44.08,
        "start": 42.08,
        "text": "そうだね、行こうか"
      },
      {
        "end": 50.08,
        "start": 44.08,
        "text": "じゃあ私、本で広島について調べておく"
      },
      {
        "end": 56.08,
        "start": 50.08,
        "text": "それからお父さんが安い旅館を知っていると言ってたから"
      },
      {
        "end": 58.08,
        "start": 56.08,
        "text": "お父さんに聞いておく"
      },
      {
        "end": 62.08,
        "start": 58.08,
        "text": "私は宿題をしておかなきゃ"
      }
    ]
  },
  "W15_C": {
    "duration": 69.07,
    "language": "ja",
    "languageProbability": 0.9899,
    "segments": [
      {
        "end": 7.84,
        "start": 0.3,
        "text": "みなさん 桜大学を知っていますか"
      },
      {
        "end": 13.46,
        "start": 7.84,
        "text": "桜大学は大きくてとても綺麗な大学です"
      },
      {
        "end": 22.67,
        "start": 13.46,
        "text": "大学には夜10時まで泳げるプールや1日中勉強できる図書館があります"
      },
      {
        "end": 28.77,
        "start": 22.67,
        "text": "大学の近くにショッピングモールがあるのでとても便利です"
      },
      {
        "end": 34.13,
        "start": 28.77,
        "text": "ショッピングモールには色々な国の料理が食べられるレストランや"
      },
      {
        "end": 42.64,
        "start": 34.13,
        "text": "24時間買い物ができるスーパーや美味しいコーヒーが飲めるカフェがあります"
      },
      {
        "end": 47.8,
        "start": 42.64,
        "text": "この大学の日本語のクラスはとても有名です"
      },
      {
        "end": 53.24,
        "start": 47.8,
        "text": "日本語を勉強している留学生がたくさんいます"
      },
      {
        "end": 55.04,
        "start": 53.24,
        "text": "どうですか"
      },
      {
        "end": 59.48,
        "start": 55.04,
        "text": "みなさんも一緒にここで勉強しませんか"
      },
      {
        "end": 64.6,
        "start": 59.48,
        "text": "じゃあみなさん 桜大学で会いましょう"
      }
    ]
  }
}
