  "W14_A": {
    "duration": 65.62,
    "language": "ja",
    "languageProbability": 0.9859,
    "segments": [
      {
        "end": 6.46,
        "start": 0.08,
        "text": "第14課 聞く練習"
      },
      {
        "end": 7.46,
        "start": 6.46,
        "text": "えい"
      },
      {
        "end": 13.86,
        "start": 7.46,
        "text": "鈴木さん 今晩コンサートに行くんですか"
      },
      {
        "end": 20.86,
        "start": 13.86,
        "text": "いえ 森さんは風を引いていけないから私にチケットをくれたんです"
      },
      {
        "end": 28.86,
        "start": 20.86,
        "text": "でも私も忙しくて時間がないかもしれないから友達にあげました"
      },
      {
        "end": 31.86,
        "start": 28.86,
        "text": "吉田さん コンサートに行くんですか"
      },
      {
        "end": 40.86,
        "start": 32.86,
        "text": "いえ 鈴木さんがチケットをくれたんですが私は今晩早く帰らなきゃいけないから"
      },
      {
        "end": 45.86,
        "start": 40.86,
        "text": "田中さんどうですか もらってください"
      },
      {
        "end": 52.86,
        "start": 45.86,
        "text": "ありがとう 今日早く仕事が終わったからいけると思います"
      },
      {
        "end": 60.86,
        "start": 52.86,
        "text": "でも そのチケット 実は私が昨日森さんにあげたんですよ"
      }
    ]
  },
  "W14_B": {
    "duration": 140.56,
    "language": "ja",
    "languageProbability": 0.9851,
    "segments": [
      {
        "end": 5.23,
        "start": 0.11,
        "text": "B 1"
      },
      {
        "end": 10.39,
        "start": 5.23,
        "text": "ゆきさん髪を切ったんですか? 似合いますよ"
      },
      {
        "end": 14.99,
        "start": 10.39,
        "text": "ありがとう 私も髪を切りたいんですが"
      },
      {
        "end": 20.83,
        "start": 14.99,
        "text": "いいところを知っていますか? 大学の近くにありますよ"
      },
      {
        "end": 26.51,
        "start": 20.83,
        "text": "そこには英語が話せる人がいますか? いないと思います"
      },
      {
        "end": 33.63,
        "start": 26.51,
        "text": "じゃあだめですね バステイの前の美容院に行ったらどうですか?"
      },
      {
        "end": 39.11,
        "start": 33.63,
        "text": "英語がわかる人がいますから じゃあそこに行ってみます"
      },
      {
        "end": 44.49,
        "start": 39.11,
        "text": "どうもありがとう 2"
      },
      {
        "end": 51.81,
        "start": 44.49,
        "text": "日本語をもっと話したいんです いつも留学生の友達と英語を話しているから"
      },
      {
        "end": 58.49,
        "start": 51.81,
        "text": "全然上手にならないんです ホームステイをしたらどうですか?"
      },
      {
        "end": 65.57,
        "start": 58.49,
        "text": "でも僕は肉や魚を食べないから ちょっと難しいと思うんです"
      },
      {
        "end": 72.45,
        "start": 65.57,
        "text": "そうですか じゃあ何かサークルに入ったらどうですか?"
      },
      {
        "end": 76.93,
        "start": 72.45,
        "text": "サークルねえ いいかもしれませんね"
      },
      {
        "end": 83.39,
        "start": 76.93,
        "text": "もっと運動したいと思っていたんです どうもありがとう"
      },
      {
        "end": 85.83,
        "start": 83.39,
        "text": "さん"
      },
      {
        "end": 89.23,
        "start": 85.83,
        "text": "もうすぐクリスマスですね"
      },
      {
        "end": 95.11,
        "start": 89.23,
        "text": "ええ ホストファミリーの子供たちに何かあげたいんですが"
      },
      {
        "end": 101.07,
        "start": 95.11,
        "text": "何がいいと思いますか? 子供たちは何歳ですか?"
      },
      {
        "end": 105.63,
        "start": 101.07,
        "text": "えっと 5歳から11歳です"
      },
      {
        "end": 111.27,
        "start": 105.63,
        "text": "全部で7人です えー7人もいるんですか?"
      },
      {
        "end": 117.75,
        "start": 111.27,
        "text": "ええ あまりお金がないんですが何かあげたいんです"
      },
      {
        "end": 122.31,
        "start": 117.75,
        "text": "うーん 難しいですね"
      },
      {
        "end": 127.11,
        "start": 122.31,
        "text": "あ 一緒にケーキを作ったらどうですか?"
      },
      {
        "end": 132.07,
        "start": 127.11,
        "text": "一緒に作るのは楽しいし みんなで食べられるし"
      },
      {
        "end": 135.75,
        "start": 132.07,
        "text": "それはいいですね"
      }
    ]
  },
