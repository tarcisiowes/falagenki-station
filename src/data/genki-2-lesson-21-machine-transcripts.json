        "text": "第21課"
      },
      {
        "end": 5,
        "start": 3,
        "text": "聞く練習"
      },
      {
        "end": 7.28,
        "start": 5,
        "text": "えい"
      },
      {
        "end": 11.87,
        "start": 7.28,
        "text": "いち"
      },
      {
        "end": 13.87,
        "start": 11.87,
        "text": "あああ"
      },
      {
        "end": 15.87,
        "start": 13.87,
        "text": "眠い"
      },
      {
        "end": 18.87,
        "start": 15.87,
        "text": "また遅くまでゲームしてたんでしょう"
      },
      {
        "end": 20.87,
        "start": 18.87,
        "text": "してないよ"
      },
      {
        "end": 25.87,
        "start": 20.87,
        "text": "今朝早く隣の人のアラームで起こされちゃったんだ"
      },
      {
        "end": 28.87,
        "start": 25.87,
        "text": "その人すぐ起きないから"
      },
      {
        "end": 31.87,
        "start": 28.87,
        "text": "うるさくて僕が落ちちゃうんだ"
      },
      {
        "end": 34.87,
        "start": 31.87,
        "text": "これでもう3回目だよ"
      },
      {
        "end": 38.87,
        "start": 34.87,
        "text": "静かにしてくださいって言ったほうがいいよ"
      },
      {
        "end": 39.87,
        "start": 38.87,
        "text": "うーん"
      },
      {
        "end": 43.24,
        "start": 39.87,
        "text": "2"
      },
      {
        "end": 46.74,
        "start": 43.24,
        "text": "どうしたの?"
      },
      {
        "end": 49.74,
        "start": 46.74,
        "text": "昨日と同じ服着て"
      },
      {
        "end": 54.74,
        "start": 49.74,
        "text": "実は昨日の夜みんなで飲んで3時ごろ帰ったら"
      },
      {
        "end": 58.74,
        "start": 54.74,
        "text": "奥さんに鍵をかけられちゃって"
      },
      {
        "end": 61.74,
        "start": 58.74,
        "text": "家に入れてくれなかったの?"
      },
      {
        "end": 62.74,
        "start": 61.74,
        "text": "うん"
      },
      {
        "end": 65.74,
        "start": 62.74,
        "text": "だから昨日と同じ服"
      },
      {
        "end": 70.74,
        "start": 65.74,
        "text": "今日は奥さんに何かプレゼント買って帰ったほうがいいよ"
      }
    ]
  },
  "W21_B": {
    "duration": 73.53,
    "language": "ja",
    "languageProbability": 0.9837,
    "segments": [
      {
        "end": 1.41,
        "start": 0.11,
        "text": "B"
      },
      {
        "end": 7.06,
        "start": 1.41,
        "text": "元気ないな、ケント。どうしたんだ?"
      },
      {
        "end": 10.26,
        "start": 7.06,
        "text": "今日は最悪な一日だったや。"
      },
      {
        "end": 12.46,
        "start": 10.26,
        "text": "何があったんだよ?"
      },
      {
        "end": 15.66,
        "start": 12.46,
        "text": "朝起きたら牛乳がなかった。"
      },
      {
        "end": 21.66,
        "start": 15.66,
        "text": "冷蔵庫に入れてあったんだけど、ルームメートの林に全部飲まれたんだ。"
      },
      {
        "end": 24.56,
        "start": 21.66,
        "text": "牛乳飲まれて怒っているのか?"
      },
      {
        "end": 26.66,
        "start": 24.56,
        "text": "牛乳はいいよ。"
      },
      {
        "end": 32.46,
        "start": 26.96,
        "text": "昨日の夜、パソコンで歴史のレポート書いていたんだよ。"
      },
      {
        "end": 35.86,
        "start": 32.46,
        "text": "消さみたらファイルがないんだ。"
      },
      {
        "end": 38.86,
        "start": 35.86,
        "text": "林にファイルを消されたんだ。"
      },
      {
        "end": 42.36,
        "start": 38.86,
        "text": "え、それは大変だ。"
      },
      {
        "end": 48.06,
        "start": 42.36,
        "text": "夜、僕のパソコンを使っている間に消しちゃったんだって。"
      },
      {
        "end": 52.36,
        "start": 48.06,
        "text": "じゃあ、歴史のレポートは出さなかったのか?"
      },
      {
        "end": 54.86,
        "start": 52.36,
        "text": "今日、締め切りだっただろう?"
      },
      {
        "end": 56.16,
        "start": 54.86,
        "text": "うん。"
      },
      {
        "end": 61.36,
        "start": 56.16,
        "text": "だから、経済のクラスで歴史のレポート書いていたんだ。"
      },
      {
        "end": 65.36,
        "start": 61.36,
        "text": "それを先生に見られて怒られたんだよ。"
      },
      {
        "end": 68.36,
        "start": 65.36,
        "text": "それはひどい一日だ。"
      }
    ]
  },
