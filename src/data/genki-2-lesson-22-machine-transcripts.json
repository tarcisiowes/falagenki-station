  "K22_01": {
    "duration": 56.06,
    "language": "ja",
    "languageProbability": 0.9949,
    "segments": [
      {
        "end": 3.11,
        "start": 0.11,
        "text": "第22課"
      },
      {
        "end": 6.61,
        "start": 3.11,
        "text": "日本の教育"
      },
      {
        "end": 8.61,
        "start": 6.61,
        "text": "会話"
      },
      {
        "end": 10.61,
        "start": 8.61,
        "text": "1"
      },
      {
        "end": 14.11,
        "start": 10.61,
        "text": "マナ、勉強しなさい。"
      },
      {
        "end": 20.11,
        "start": 14.11,
        "text": "来週は期末試験があるのに、全然勉強していないでしょう。"
      },
      {
        "end": 26.61,
        "start": 20.11,
        "text": "お母さん、私、もう17なんだから、少し掘っておいてよ。"
      },
      {
        "end": 33.11,
        "start": 26.61,
        "text": "今頑張っておけば、いい大学に入れて、後で楽になるんだから。"
      },
      {
        "end": 37.61,
        "start": 33.11,
        "text": "私、別にいい大学に行けなくてもいい。"
      },
      {
        "end": 43.61,
        "start": 37.61,
        "text": "お父さんとお母さんは、あなたをいい大学に行かせてあげたいの。"
      },
      {
        "end": 49.61,
        "start": 43.61,
        "text": "お母さんのうちは貧乏だったから、大学に行かせてくれなかったのよ。"
      },
      {
        "end": 55.61,
        "start": 49.61,
        "text": "わかった、わかった。その話、もう何度も聞いた。"
      }
    ]
  },
