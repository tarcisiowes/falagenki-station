  "K22_03": {
    "duration": 28.66,
    "language": "ja",
    "languageProbability": 0.9905,
    "segments": [
      {
        "end": 2.41,
        "start": 0.11,
        "text": "2"
      },
      {
        "end": 15.19,
        "start": 2.41,
        "text": "メアリーも高校の時こんな風だった? そうね。やっぱり親はうるさかったけど、もう少し自由があったかな。"
      },
      {
        "end": 28.51,
        "start": 15.19,
        "text": "うちの親ちょっと変だと思うでしょ? そんなことないよ。ちょっと厳しいかもしれないけど、マナちゃんのことを心配しているんだよ。"
      }
    ]
  },
