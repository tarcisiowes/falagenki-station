  "K22_05": {
    "duration": 39.5,
    "language": "ja",
    "languageProbability": 0.9884,
    "segments": [
      {
        "end": 2.45,
        "start": 0.21,
        "text": "さん"
      },
      {
        "end": 9.55,
        "start": 2.45,
        "text": "うちのマナちゃん高校生なのに忙しくて全然遊ぶ時間がないみたい"
      },
      {
        "end": 14.05,
        "start": 9.55,
        "text": "子供も大変だけど親も大変だと思うよ"
      },
      {
        "end": 20.55,
        "start": 14.05,
        "text": "熟に行かせたり英会話を習わせたりお金がかかるだろうな"
      },
      {
        "end": 26.05,
        "start": 20.55,
        "text": "たけしくんも子供の時マナちゃんのように熟に行ってた?"
      },
      {
        "end": 33.05,
        "start": 26.21,
        "text": "僕はずっと遊んでた自分の子供にも自由に遊ばせてあげたいな"
      },
      {
        "end": 39.33,
        "start": 33.05,
        "text": "でも日本で子供を育てるのは大変そうだね"
      }
    ]
  },
