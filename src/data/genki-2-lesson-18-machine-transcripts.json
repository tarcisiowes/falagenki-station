  "W18_A": {
    "duration": 70.24,
    "language": "ja",
    "languageProbability": 0.9841,
    "segments": [
      {
        "end": 5.05,
        "start": 0.05,
        "text": "第18日 聞く練習"
      },
      {
        "end": 7.49,
        "start": 5.05,
        "text": "うい"
      },
      {
        "end": 10.86,
        "start": 7.49,
        "text": "ただいま"
      },
      {
        "end": 13.86,
        "start": 10.86,
        "text": "お母さん、晩御飯ある?"
      },
      {
        "end": 16.86,
        "start": 13.86,
        "text": "え? なんよ?"
      },
      {
        "end": 22.86,
        "start": 16.86,
        "text": "今日、友達と晩御飯を食べに行くって言っていたでしょ?"
      },
      {
        "end": 23.86,
        "start": 22.86,
        "text": "うん"
      },
      {
        "end": 28.86,
        "start": 23.86,
        "text": "でも、店が開いていなかったから食べられなかったの"
      },
      {
        "end": 31.86,
        "start": 28.86,
        "text": "じゃあ、カップラーメンある?"
      },
      {
        "end": 34.86,
        "start": 31.86,
        "text": "お父さんが食べちゃったよ"
      },
      {
        "end": 36.86,
        "start": 34.86,
        "text": "え?"
      },
      {
        "end": 39.86,
        "start": 36.86,
        "text": "じゃあ、私が買ったケーキは?"
      },
      {
        "end": 41.86,
        "start": 39.86,
        "text": "何言ってるの?"
      },
      {
        "end": 45.86,
        "start": 41.86,
        "text": "昨日、みんなで食べちゃったでしょ?"
      },
      {
        "end": 47.86,
        "start": 45.86,
        "text": "うーん"
      },
      {
        "end": 51.86,
        "start": 47.86,
        "text": "じゃあ、田中さんにもらったクッキーは?"
      },
      {
        "end": 55.86,
        "start": 51.86,
        "text": "あれは、隣の子供にあげちゃったよ"
      },
      {
        "end": 57.86,
        "start": 55.86,
        "text": "え?"
      },
      {
        "end": 63.86,
        "start": 57.86,
        "text": "ああ、家に帰る前に、コンビニで食べるもの買えばよかった"
      }
    ]
  },
