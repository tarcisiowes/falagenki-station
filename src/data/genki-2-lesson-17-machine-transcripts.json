  "W17_A": {
    "duration": 64.81,
    "language": "ja",
    "languageProbability": 0.9912,
    "segments": [
      {
        "end": 9.06,
        "start": 0.11,
        "text": "第十七課、聞く練習、えい"
      },
      {
        "end": 13.06,
        "start": 9.06,
        "text": "山本さん、会社をやめるそうですよ"
      },
      {
        "end": 17.06,
        "start": 13.06,
        "text": "え、本当ですか?"
      },
      {
        "end": 21.06,
        "start": 17.06,
        "text": "最近、ずいぶん疲れているみたいですからね"
      },
      {
        "end": 27.06,
        "start": 21.06,
        "text": "ええ、毎日、夜遅くまで残業していたみたいですよ"
      },
      {
        "end": 32.06,
        "start": 27.06,
        "text": "この会社は給料はいいけど、残業が多すぎますよ"
      },
      {
        "end": 36.06,
        "start": 32.06,
        "text": "山本さん、これからどうするんですか?"
      },
      {
        "end": 41.06,
        "start": 36.06,
        "text": "今、新しい仕事を探しているみたいですよ"
      },
      {
        "end": 45.06,
        "start": 41.06,
        "text": "奥さんとも離婚するそうですよ"
      },
      {
        "end": 52.06,
        "start": 45.06,
        "text": "やっぱり、忙しすぎて家にあまりいられないんでしょうね"
      },
      {
        "end": 59.06,
        "start": 52.06,
        "text": "私たちも結婚する前に新しい仕事を探した方がいいかもしれませんね"
      }
    ]
  },
  "W17_B": {
    "duration": 40.36,
    "language": "ja",
    "languageProbability": 0.9955,
    "segments": [
      {
        "end": 4.89,
        "start": 0.08,
        "text": "ビー、急ぎましょうか。"
      },
      {
        "end": 9.89,
        "start": 4.89,
        "text": "急がなくてもいいですよ。1時間ありますから。"
      },
      {
        "end": 14.89,
        "start": 9.89,
        "text": "出かける前に、田中さんに電話しておかなきゃいけませんね。"
      },
      {
        "end": 17.39,
        "start": 14.89,
        "text": "そうですね。"
      },
      {
        "end": 19.89,
        "start": 17.39,
        "text": "傘を持っていきますか?"
      },
      {
        "end": 22.39,
        "start": 19.89,
        "text": "持っていかなくてもいいと思います。"
      },
      {
        "end": 25.89,
        "start": 22.39,
        "text": "今日は雨が降らないそうです。"
      },
      {
        "end": 29.39,
        "start": 25.89,
        "text": "何か買っていったほうがいいですね。"
      },
      {
        "end": 34.39,
        "start": 29.39,
        "text": "じゃあ、バスを降りてからケーキと花を買いましょう。"
      }
    ]
  },
  "W17_C": {
    "duration": 65.59,
    "language": "ja",
    "languageProbability": 0.988,
    "segments": [
      {
        "end": 2.67,
        "start": 0.27,
        "text": "シー"
      },
      {
        "end": 6.43,
        "start": 2.67,
        "text": "メアリー ソラさんに電話した?"
      },
      {
        "end": 14.43,
        "start": 6.43,
        "text": "うん。ソラさん、土曜日は約束があるからダメだけど、日曜日なら大丈夫だって"
      },
      {
        "end": 20.59,
        "start": 14.43,
        "text": "よかった。じゃあ、日曜日にみんなで神戸に行けるね"
      },
      {
        "end": 24.19,
        "start": 20.59,
        "text": "メアリーは神戸で何がしたい?"
      },
      {
        "end": 28.67,
        "start": 24.19,
        "text": "私、おいしいものが食べたい"
      },
      {
        "end": 37.07,
        "start": 28.75,
        "text": "神戸には色々な国のレストランがあるし、ソラさんは買い物がしたいって"
      },
      {
        "end": 40.59,
        "start": 37.07,
        "text": "タケシ君は何がしたい?"
      },
      {
        "end": 47.63,
        "start": 40.59,
        "text": "僕はロッコウさんに行きたい。ロッコウさんからきれいな海が見えるそうだよ"
      },
      {
        "end": 52.67,
        "start": 47.63,
        "text": "じゃあ、いい天気だったらロッコウさんに登ろうよ"
      },
      {
        "end": 54.11,
        "start": 52.67,
        "text": "うん"
      },
      {
        "end": 61.23,
        "start": 54.11,
        "text": "雨が降ったら、街で買い物をしたり、おいしいものを食べたりしよう"
      }
    ]
  }
