      {
        "end": 8.89,
        "start": 0.08,
        "text": "第17日 口と噂話 会話"
      },
      {
        "end": 11.29,
        "start": 8.89,
        "text": "1"
      },
      {
        "end": 15.09,
        "start": 11.29,
        "text": "たけしさん、久しぶりですね"
      },
      {
        "end": 18.49,
        "start": 15.09,
        "text": "旅行会社に就職したそうですね"
      },
      {
        "end": 20.79,
        "start": 18.49,
        "text": "おめでとうございます"
      },
      {
        "end": 23.19,
        "start": 20.79,
        "text": "ありがとうございます"
      },
      {
        "end": 25.99,
        "start": 23.19,
        "text": "もう仕事になれましたか?"
      },
      {
        "end": 27.69,
        "start": 26.29,
        "text": "ええ"
      },
      {
        "end": 33.59,
        "start": 27.69,
        "text": "でも学生の時に比べてすごく忙しくなりました"
      },
      {
        "end": 37.29,
        "start": 33.59,
        "text": "自分の時間が全然ないんです"
      },
      {
        "end": 39.99,
        "start": 37.29,
        "text": "大変ですね"
      },
      {
        "end": 46.69,
        "start": 39.99,
        "text": "私の友達の会社は休みが多くて残業しなくてもいいそうですよ"
      },
      {
        "end": 49.29,
        "start": 46.69,
        "text": "うらやましいな"
      },
      {
        "end": 56.89,
        "start": 49.29,
        "text": "僕の会社は休みも少ないし、給料も安いし最悪です"
      },
      {
        "end": 62.09,
        "start": 56.89,
        "text": "会社に入る前にどうしてもっと調べなかったんですか?"
      },
      {
        "end": 68.39,
        "start": 62.09,
        "text": "旅行会社に入ったら旅行ができると思ったんです"
      }
    ]
  },
