    "segments": [
      {
        "end": 9.31,
        "start": 0.08,
        "text": "B 桜大学のみなさんこんにちは ゆかです"
      },
      {
        "end": 18.06,
        "start": 9.31,
        "text": "部屋が汚くてすみません 私の後ろあまり見ないでください"
      },
      {
        "end": 24.62,
        "start": 18.06,
        "text": "私は今南オハイオ大学に留学しています"
      },
      {
        "end": 31.1,
        "start": 24.62,
        "text": "アメリカに来た時は英語がわからなかったから大変でした"
      },
      {
        "end": 36.62,
        "start": 31.26,
        "text": "でも今は毎日とても楽しいです"
      },
      {
        "end": 43.1,
        "start": 36.62,
        "text": "ホストファミリーのお父さんとお母さんはとても親切です"
      },
      {
        "end": 50.75,
        "start": 43.1,
        "text": "私は英語が下手なのでいつもゆっくり話してくれます"
      },
      {
        "end": 59.79,
        "start": 50.75,
        "text": "ホストファミリーには子供が二人います 名前はジョンとサラです"
      },
      {
        "end": 68.83,
        "start": 59.87,
        "text": "ジョンはよく私をパーティーに連れて行ってくれたり 友達を紹介してくれたりします"
      },
      {
        "end": 78.19,
        "start": 68.83,
        "text": "ジョンは大学で日本語を勉強しているので私はよく宿題を手伝ってあげます"
      },
      {
        "end": 84.03,
        "start": 78.19,
        "text": "サラはよく私に服を貸してくれます"
      },
      {
        "end": 90.16,
        "start": 84.11,
        "text": "私は日本の歌を教えてあげます"
      },
      {
        "end": 96.16,
        "start": 90.16,
        "text": "ジョンとサラが日本の大学生と話してみたいと言っているので"
      },
      {
        "end": 102.32,
        "start": 96.16,
        "text": "興味がある人はビデオチャットに参加してくれませんか"
      },
      {
        "end": 106.56,
        "start": 102.32,
        "text": "よろしくお願いします じゃあ"
      },
      {
        "end": 109.28,
        "start": 106.56,
        "text": "お元気で"
      }
    ]
  },
  "W16_C": {
    "duration": 76.67,
    "language": "ja",
    "languageProbability": 0.976,
    "segments": [
      {
        "end": 7.16,
        "start": 0.11,
        "text": "すぃ リエさんお誕生日おめでとうございます"
      },
      {
        "end": 13.42,
        "start": 7.16,
        "text": "はたちになって何をしてみたいですか そうですねー"
      },
      {
        "end": 23.04,
        "start": 13.42,
        "text": "今年は中国でコンサートができるといいですね 中国でもリエさんの歌はとても人気があるんですよね"
      },
      {
        "end": 28.98,
        "start": 23.04,
        "text": "ありがとうございます でも忙しくて大変ですね"
      },
      {
        "end": 33.82,
        "start": 28.98,
        "text": "ええ もっと休みが取れるといいんですが"
      },
      {
        "end": 41.06,
        "start": 33.82,
        "text": "実は先月は休みが3日しかなかったんです そうですか"
      },
      {
        "end": 47.42,
        "start": 41.06,
        "text": "あのー リエさんは歌手の最上さんと付き合っていますが"
      },
      {
        "end": 54.34,
        "start": 47.42,
        "text": "結婚する予定は 最上さんとは今はいい友達です"
      },
      {
        "end": 61.9,
        "start": 54.46,
        "text": "私も彼も若いし今はもっと仕事をしたいし そうですか"
      },
      {
        "end": 68.9,
        "start": 61.9,
        "text": "それは私たちにはいいニュースですね これからも頑張ってください"
      },
      {
        "end": 72.34,
        "start": 68.9,
        "text": "どうもありがとうございます"
      }
    ]
  }
