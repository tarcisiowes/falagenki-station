      {
        "end": 4.58,
        "start": 0.08,
        "text": "第16日 きくれんしゅう"
      },
      {
        "end": 8.66,
        "start": 4.58,
        "text": "えい"
      },
      {
        "end": 12.36,
        "start": 8.66,
        "text": "はなこさん 好きだよ"
      },
      {
        "end": 19.36,
        "start": 12.36,
        "text": "うれしい たろうさん 私も たろうさんが好きよ"
      },
      {
        "end": 22.86,
        "start": 19.36,
        "text": "はやくはなこさんと結婚したい"
      },
      {
        "end": 28.16,
        "start": 22.86,
        "text": "僕が毎日 おいしい朝ごはんをつくってあげるよ"
      },
      {
        "end": 33.46,
        "start": 28.36,
        "text": "朝起きたとき ベッドでコーヒーが飲みたい"
      },
      {
        "end": 39.06,
        "start": 33.46,
        "text": "じゃあ毎朝コーヒーで はなこさんをおこしてあげるよ"
      },
      {
        "end": 42.86,
        "start": 39.06,
        "text": "ありがとう あのー"
      },
      {
        "end": 46.86,
        "start": 42.86,
        "text": "たろうさん どうしたの"
      },
      {
        "end": 52.86,
        "start": 46.86,
        "text": "私 掃除があまり好きじゃないの"
      },
      {
        "end": 57.06,
        "start": 52.86,
        "text": "心配しないで 僕がしてあげるから"
      },
      {
        "end": 62.36,
        "start": 57.06,
        "text": "本当? じゃあ私買い物する"
      },
      {
        "end": 68.06,
        "start": 62.36,
        "text": "時々買いすぎるけど 買い物ならできると思う"
      },
      {
        "end": 70.96,
        "start": 68.06,
        "text": "あの はなこさん"
      },
      {
        "end": 74.96,
        "start": 70.96,
        "text": "僕のシャツにアイロンをかけてくれる?"
      },
      {
        "end": 80.56,
        "start": 74.96,
        "text": "会社で はなこさんがアイロンをかけてくれたシャツを着たいんだ"
      },
      {
        "end": 83.56,
        "start": 80.66,
        "text": "ええ いいけど"
      },
      {
        "end": 86.16,
        "start": 83.56,
        "text": "選択はしてね"
      },
      {
        "end": 88.16,
        "start": 86.16,
        "text": "うん"
      }
    ]
  },
  "W16_B": {
    "duration": 113.95,
    "language": "ja",
